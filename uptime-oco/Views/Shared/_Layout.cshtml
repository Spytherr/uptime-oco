<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - uptime-oco</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.49.1/dist/apexcharts.min.js"></script>
</head>
<body class="h-full bg-oco-bg text-oco-text">
    <div class="flex h-full">
        <aside class="w-64 bg-oco-surface border-r border-oco-border flex flex-col shrink-0">
            <div class="p-5 border-b border-oco-border">
                <a asp-controller="Dashboard" asp-action="Index" class="text-xl font-bold text-oco-text no-underline">
                    uptime-oco
                </a>
            </div>
            <nav class="flex-1 p-4 space-y-1">
                <a asp-controller="Dashboard" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-oco-muted hover:bg-oco-surface-2 hover:text-oco-text transition-colors no-underline">
                    <span>Dashboard</span>
                </a>
                <a asp-controller="Monitors" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-oco-muted hover:bg-oco-surface-2 hover:text-oco-text transition-colors no-underline">
                    <span>Monitors</span>
                </a>
                <a asp-controller="Incidents" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-oco-muted hover:bg-oco-surface-2 hover:text-oco-text transition-colors no-underline">
                    <span>Incidents</span>
                </a>
                <a asp-controller="Notifications" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-2.5 rounded-lg text-oco-muted hover:bg-oco-surface-2 hover:text-oco-text transition-colors no-underline">
                    <span>Notifications</span>
                </a>
            </nav>
            <div class="p-4 border-t border-oco-border">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit"
                            class="w-full px-4 py-2.5 rounded-lg text-oco-muted hover:bg-oco-surface-2 hover:text-oco-down transition-colors text-left">
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden">
            <main class="flex-1 overflow-y-auto p-6">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
