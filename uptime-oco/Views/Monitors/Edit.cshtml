@model EditMonitorViewModel
@{
    ViewData["Title"] = "Edit Monitor";
}

<div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold">Edit Monitor</h1>

    <form asp-action="Edit" method="post" class="space-y-5">
        <div asp-validation-summary="ModelOnly" class="text-oco-down text-sm"></div>
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Name" class="block text-sm font-medium text-oco-muted mb-1"></label>
            <input asp-for="Name" class="w-full px-4 py-2 bg-oco-surface border border-oco-border rounded-lg text-oco-text focus:outline-none focus:border-oco-accent" />
            <span asp-validation-for="Name" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Url" class="block text-sm font-medium text-oco-muted mb-1"></label>
            <input asp-for="Url" class="w-full px-4 py-2 bg-oco-surface border border-oco-border rounded-lg text-oco-text focus:outline-none focus:border-oco-accent" />
            <span asp-validation-for="Url" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label asp-for="IntervalSeconds" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="IntervalSeconds" type="number" min="10" max="3600" class="w-full px-4 py-2 bg-oco-surface border border-oco-border rounded-lg text-oco-text focus:outline-none focus:border-oco-accent" />
                <span asp-validation-for="IntervalSeconds" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="RetryThreshold" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="RetryThreshold" type="number" min="1" max="10" class="w-full px-4 py-2 bg-oco-surface border border-oco-border rounded-lg text-oco-text focus:outline-none focus:border-oco-accent" />
                <span asp-validation-for="RetryThreshold" class="text-oco-down text-sm mt-1 block"></span>
            </div>
        </div>

        <div>
            <label class="flex items-center gap-3 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="w-5 h-5 rounded border-oco-border bg-oco-surface text-oco-accent focus:ring-oco-accent" />
                <span class="text-sm text-oco-text">Active (monitoring enabled)</span>
            </label>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 bg-oco-accent text-white rounded-lg hover:opacity-90 transition-opacity font-medium">
                Save Changes
            </button>
            <a asp-action="Index" class="px-5 py-2.5 bg-oco-surface border border-oco-border rounded-lg text-oco-muted hover:text-oco-text no-underline">
                Cancel
            </a>
        </div>
    </form>
</div>
