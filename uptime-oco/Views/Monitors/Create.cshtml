@model CreateMonitorViewModel
@{
    ViewData["Title"] = "Create Monitor";
}

<div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold">Create Monitor</h1>

    <form asp-action="Create" method="post" class="space-y-5 border-2 border-oco-border bg-oco-surface p-6">
        <div asp-validation-summary="ModelOnly" class="text-oco-down text-sm"></div>

        <div>
            <label asp-for="Name" class="block text-sm font-medium text-oco-muted mb-1"></label>
            <input asp-for="Name" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
            <span asp-validation-for="Name" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Url" class="block text-sm font-medium text-oco-muted mb-1"></label>
            <input asp-for="Url" placeholder="https://example.com/health" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text placeholder-oco-muted focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
            <span asp-validation-for="Url" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="IntervalSeconds" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="IntervalSeconds" type="number" min="10" max="3600" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="IntervalSeconds" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ExpectedStatusCode" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="ExpectedStatusCode" type="number" min="100" max="599" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="ExpectedStatusCode" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="TimeoutSeconds" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="TimeoutSeconds" type="number" min="1" max="60" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="TimeoutSeconds" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="RetryThreshold" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="RetryThreshold" type="number" min="1" max="10" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="RetryThreshold" class="text-oco-down text-sm mt-1 block"></span>
            </div>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 border-2 border-oco-border bg-oco-accent text-oco-text hover:opacity-90 transition-opacity font-medium">
                Create Monitor
            </button>
            <a asp-action="Index" class="px-5 py-2.5 border-2 border-oco-border bg-oco-surface text-oco-text hover:bg-oco-surface-2 hover:text-oco-text transition-colors no-underline">
                Cancel
            </a>
        </div>
    </form>
</div>
