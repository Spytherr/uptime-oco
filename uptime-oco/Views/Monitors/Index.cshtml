@model PaginatedList<Monitor>
@{
    ViewData["Title"] = "Monitors";
    var search = ViewData["Search"] as string;
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Monitors</h1>
        <a asp-action="Create" class="oco-button oco-button-primary oco-button-lg font-medium">
            + New Monitor
        </a>
    </div>

    <form method="get" class="flex gap-3">
        <input type="text" name="search" value="@search" placeholder="Search by name or URL..."
               class="flex-1 px-4 py-2 bg-oco-surface border-2 border-oco-border text-oco-text placeholder-oco-muted focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
        <button type="submit" class="oco-button oco-button-secondary oco-button-lg">
            Search
        </button>
    </form>

    <div class="space-y-3">
        @foreach (var monitor in Model.Items)
        {
            <partial name="_MonitorCard" model="monitor" />
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 pt-4">
            @if (Model.HasPreviousPage)
            {
                <a asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.PageIndex - 1)"
                   class="oco-button oco-button-secondary">
                    Prev
                </a>
            }

            <span class="px-4 py-2 text-oco-muted text-sm">
                Page @Model.PageIndex of @Model.TotalPages
            </span>

            @if (Model.HasNextPage)
            {
                <a asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.PageIndex + 1)"
                   class="oco-button oco-button-secondary">
                    Next
                </a>
            }
        </div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-12 text-oco-muted">
            <p>No monitors found. Create one to get started.</p>
        </div>
    }
</div>
