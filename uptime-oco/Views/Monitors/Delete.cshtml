@model Monitor
@{
    ViewData["Title"] = "Delete Monitor";
}

<div class="max-w-2xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold">Delete Monitor</h1>

    <div class="bg-oco-surface p-6 border-2 border-oco-border">
        <p class="text-oco-muted mb-4">Are you sure you want to delete this monitor? All associated ping results and incidents will also be removed.</p>

        <div class="space-y-3 mb-6">
            <div>
                <span class="text-oco-muted text-sm">Name:</span>
                <span class="font-medium ml-2">@Model.Name</span>
            </div>
            <div>
                <span class="text-oco-muted text-sm">URL:</span>
                <span class="font-medium ml-2 break-all">@Model.Url</span>
            </div>
        </div>

        <form asp-action="Delete" method="post" class="flex gap-3">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="oco-button oco-button-danger-solid oco-button-lg font-medium">
                Yes, Delete
            </button>
            <a asp-action="Index" class="oco-button oco-button-secondary oco-button-lg">
                Cancel
            </a>
        </form>
    </div>
</div>
