@model MonitorDetailsViewModel
@{
    var monitor = Model.Monitor;
    var chartData = Model.ResponseTimeSeries
        .OrderBy(p => p.CheckedAt)
        .Select(p => new
        {
            checkedAt = DateTime.SpecifyKind(p.CheckedAt, DateTimeKind.Utc),
            responseTimeMs = p.ResponseTimeMs,
            monitorId = p.MonitorId,
            monitorName = p.MonitorName
        })
        .ToList();
    ViewData["Title"] = monitor.Name;
    var uptimeColor = monitor.UptimePercent >= 99 ? "text-oco-up" : monitor.UptimePercent >= 90 ? "text-oco-warn" : "text-oco-down";
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-4">
            <h1 class="text-2xl font-bold">@monitor.Name</h1>
            <partial name="_StatusBadge" model="monitor.Status" />
        </div>
        <div class="flex items-center gap-2">
            <form asp-action="ToggleActive" asp-route-id="@monitor.Id" asp-route-returnUrl="@Url.Action("Details", "Monitors", new { id = monitor.Id })" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="oco-button oco-button-lg @(monitor.IsActive ? "oco-button-warning" : "oco-button-success")">
                    @(monitor.IsActive ? "Pause" : "Resume")
                </button>
            </form>
            <a asp-action="Edit" asp-route-id="@monitor.Id" class="oco-button oco-button-secondary oco-button-lg">
                Edit
            </a>
            <a asp-action="Delete" asp-route-id="@monitor.Id" class="oco-button oco-button-danger oco-button-lg">
                Delete
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4">
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">URL</p>
            <p class="font-medium mt-1 break-all">@monitor.Url</p>
        </div>
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Interval</p>
            <p class="font-medium mt-1">@monitor.IntervalSeconds seconds</p>
        </div>
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Expected Status</p>
            <p class="font-medium mt-1">HTTP @monitor.ExpectedStatusCode</p>
        </div>
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Timeout</p>
            <p class="font-medium mt-1">@monitor.TimeoutSeconds seconds</p>
        </div>
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Retry Threshold</p>
            <p class="font-medium mt-1">@monitor.RetryThreshold failures</p>
        </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Consecutive Failures</p>
            <p class="text-2xl font-bold mt-1 @(monitor.ConsecutiveFailures > 0 ? "text-oco-down" : "text-oco-up")">
                @monitor.ConsecutiveFailures
            </p>
        </div>
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Monitoring</p>
            <p class="text-2xl font-bold mt-1 @(monitor.IsActive ? "text-oco-up" : "text-oco-muted")">
                @(monitor.IsActive ? "Active" : "Paused")
            </p>
        </div>
        <div class="bg-oco-surface p-5 border-2 border-oco-border">
            <p class="text-oco-muted text-sm">Uptime (last 24 hours)</p>
            <p class="text-2xl font-bold mt-1 @uptimeColor">
                @monitor.UptimePercent%
            </p>
        </div>
    </div>

    <div class="bg-oco-surface p-5 border-2 border-oco-border">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <h2 class="text-lg font-semibold">Response Time (last 24 hours)</h2>
            <button id="resetZoomBtn" type="button" class="oco-button oco-button-secondary">Reset Zoom</button>
        </div>
        <div id="monitorResponseTimeChart" class="min-h-[300px]"></div>
    </div>

    <div class="bg-oco-surface p-5 border-2 border-oco-border">
        <h2 class="text-lg font-semibold mb-4">Recent Ping Results</h2>
        @if (monitor.PingResults.Count > 0)
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-oco-muted text-left border-b-2 border-oco-border">
                            <th class="pb-2 pr-4">Time</th>
                            <th class="pb-2 pr-4">Status</th>
                            <th class="pb-2 pr-4">HTTP Code</th>
                            <th class="pb-2 pr-4">Failure Reason</th>
                            <th class="pb-2">Response Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ping in monitor.PingResults)
                        {
                            <tr class="border-b border-oco-border">
                                <td class="py-2 pr-4 text-oco-muted">@ping.CheckedAt.ToLocalTime().ToString("MMM dd, HH:mm:ss")</td>
                                <td class="py-2 pr-4">
                                    @if (ping.IsSuccess)
                                    {
                                        <span class="text-oco-up">OK</span>
                                    }
                                    else
                                    {
                                        <span class="text-oco-down">FAIL</span>
                                    }
                                </td>
                                <td class="py-2 pr-4 text-oco-muted">@(ping.HttpStatusCode?.ToString() ?? "—")</td>
                                <td class="py-2 pr-4 text-oco-muted">@(ping.FailureReason ?? "—")</td>
                                <td class="py-2 text-oco-muted">@(ping.ResponseTimeMs.HasValue ? $"{ping.ResponseTimeMs} ms" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-oco-muted text-sm">No ping results yet.</p>
        }
    </div>

    <div class="bg-oco-surface p-5 border-2 border-oco-border">
        <h2 class="text-lg font-semibold mb-4">Recent Incidents</h2>
        @if (monitor.Incidents.Count > 0)
        {
            <div class="space-y-3">
                @foreach (var incident in monitor.Incidents)
                {
                    <div class="flex items-center justify-between p-3 bg-oco-surface-2 border-2 border-oco-border">
                        <div>
                            <p class="text-sm">@incident.Reason</p>
                            <p class="text-xs text-oco-muted mt-1">
                                Started: @incident.StartedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                                @if (incident.ResolvedAt.HasValue)
                                {
                                    <span> · Resolved: @incident.ResolvedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-oco-down"> · Ongoing</span>
                                }
                            </p>
                        </div>
                        @if (incident.ResolvedAt.HasValue)
                        {
                            <span class="px-2 py-1 text-xs border-2 border-oco-border bg-oco-up/10 text-oco-up">Resolved</span>
                        }
                        else
                        {
                            <span class="px-2 py-1 text-xs border-2 border-oco-border bg-oco-down/10 text-oco-down">Open</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-oco-muted text-sm">No incidents recorded.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        window.monitorDetailsData = {
            responseTime: @Html.Raw(Json.Serialize(chartData)),
            monitors: @Html.Raw(Json.Serialize(new[] { new { id = monitor.Id, intervalSeconds = monitor.IntervalSeconds } })),
            monitorId: @monitor.Id
        };
    </script>
}
