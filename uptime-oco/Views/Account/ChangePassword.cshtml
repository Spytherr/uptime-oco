@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<div class="max-w-md mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-bold">Change password</h1>
        <p class="mt-1 text-sm text-oco-muted">Use a new password with at least 8 characters.</p>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="border-2 border-oco-border bg-oco-accent px-4 py-3 text-sm text-oco-text" role="status">
            @statusMessage
        </div>
    }

    <form asp-action="ChangePassword" method="post" class="space-y-5 border-2 border-oco-border bg-oco-surface p-6">
        <div asp-validation-summary="ModelOnly" class="text-oco-down text-sm"></div>

        <div>
            <label asp-for="CurrentPassword" class="block text-sm font-medium text-oco-muted mb-1">Current password</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
            <span asp-validation-for="CurrentPassword" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="block text-sm font-medium text-oco-muted mb-1">New password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
            <span asp-validation-for="NewPassword" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div>
            <label asp-for="ConfirmNewPassword" class="block text-sm font-medium text-oco-muted mb-1">Confirm new password</label>
            <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
            <span asp-validation-for="ConfirmNewPassword" class="text-oco-down text-sm mt-1 block"></span>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-5 py-2.5 border-2 border-oco-border bg-oco-accent text-oco-text hover:bg-oco-surface hover:text-oco-text transition-colors font-medium">
                Change password
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="px-5 py-2.5 border-2 border-oco-border bg-oco-surface text-oco-text hover:bg-oco-surface-2 hover:text-oco-text transition-colors no-underline">
                Cancel
            </a>
        </div>
    </form>
</div>
