@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="min-h-full flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md border-2 border-oco-border bg-oco-surface p-6">
        <div class="mb-6 text-center">
            <h1 class="text-2xl font-bold">Login</h1>
            <p class="mt-1 text-sm text-oco-muted">Sign in to manage your monitors.</p>
        </div>

        <form asp-action="Login" method="post" class="space-y-5">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly" class="text-oco-down text-sm"></div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text placeholder-oco-muted focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="Email" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="Password" type="password" autocomplete="current-password" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="Password" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <label class="flex items-center gap-3 cursor-pointer">
                <input asp-for="RememberMe" type="checkbox" class="w-5 h-5 border-2 border-oco-border bg-oco-surface text-oco-accent focus:ring-0 focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span class="text-sm text-oco-text">Remember me</span>
            </label>

            <button type="submit" class="oco-button oco-button-primary oco-button-lg w-full font-medium">
                Login
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
