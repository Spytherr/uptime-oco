@model IEnumerable<NotificationChannel>
@{
    ViewData["Title"] = "Notifications";
    var testResult = TempData["TestResult"] as string;
}

<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">Notification Channels</h1>
        <a asp-action="Create" class="oco-button oco-button-primary oco-button-lg font-medium">
            + New Channel
        </a>
    </div>

    @if (!string.IsNullOrEmpty(testResult))
    {
        <div class="px-4 py-3 border-2 border-oco-border @(testResult.Contains("successfully") ? "bg-oco-up/10 text-oco-up" : "bg-oco-down/10 text-oco-down")">
            @testResult
        </div>
    }

    <div class="space-y-3">
        @foreach (var channel in Model)
        {
            var typeLabel = channel.Type.ToString();
            var typeColor = "border-2 border-oco-border bg-oco-surface-2 text-oco-muted";

            <div class="flex items-center justify-between p-4 bg-oco-surface border-2 border-oco-border">
                <div class="flex items-center gap-4">
                    <span class="px-2 py-1 text-xs @typeColor font-medium">@typeLabel</span>
                    <div>
                        <p class="font-medium">@channel.Name</p>
                        <p class="text-sm text-oco-muted truncate max-w-md">@channel.Target</p>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    @if (channel.IsEnabled)
                    {
                        <span class="px-2 py-1 text-xs border-2 border-oco-border bg-oco-up/10 text-oco-up">Enabled</span>
                    }
                    else
                    {
                        <span class="px-2 py-1 text-xs border-2 border-oco-border bg-oco-muted/10 text-oco-muted">Disabled</span>
                    }
                    <div class="flex items-center gap-1">
                        <form asp-action="Test" asp-route-id="@channel.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="oco-button oco-button-secondary">
                                Test
                            </button>
                        </form>
                        <a asp-action="Edit" asp-route-id="@channel.Id"
                           class="oco-button oco-button-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@channel.Id"
                           class="oco-button oco-button-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12 text-oco-muted">
            <p>No notification channels configured.</p>
            <a asp-action="Create" class="text-oco-accent no-underline mt-2 inline-block">Create one to get started.</a>
        </div>
    }
</div>
