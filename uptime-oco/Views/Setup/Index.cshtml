@model SetupViewModel
@{
    ViewData["Title"] = "Setup";
}

<div class="min-h-full flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md border-2 border-oco-border bg-oco-surface p-6">
        <div class="mb-6 text-center">
            <h1 class="text-2xl font-bold">Welcome to uptime-oco</h1>
            <p class="mt-1 text-sm text-oco-muted">Create your admin account to get started.</p>
        </div>

        <form asp-action="Index" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-oco-down text-sm"></div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text placeholder-oco-muted focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="Email" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="Password" type="password" autocomplete="new-password" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="Password" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-oco-muted mb-1"></label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="w-full px-4 py-2 bg-oco-surface-2 border-2 border-oco-border text-oco-text focus:outline-2 focus:outline-offset-2 focus:outline-oco-text" />
                <span asp-validation-for="ConfirmPassword" class="text-oco-down text-sm mt-1 block"></span>
            </div>

            <button type="submit" class="oco-button oco-button-primary oco-button-lg w-full font-medium">
                Create Admin Account
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
